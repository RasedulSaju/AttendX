# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=AttendX
APP_ENV=production          # local | staging | production
APP_DEBUG=false
APP_URL=http://your-server-ip
APP_KEY=                    # 32-char random string: php -r "echo bin2hex(random_bytes(16));"
APP_TZ=Asia/Dhaka
APP_LOCALE=en

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=attendx
DB_USER=attendx_user
DB_PASS=your_strong_password

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_NAME=attendx_session
SESSION_LIFETIME=7200       # seconds (2 hours)
SESSION_SECURE=false        # true if HTTPS only

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                 # 64-char random string: php -r "echo bin2hex(random_bytes(32));"
JWT_TTL=86400               # 1 day (API tokens)
JWT_REFRESH_TTL=604800      # 7 days (mobile refresh tokens)
JWT_MOBILE_TTL=604800       # 7 days (mobile access tokens)

# ─── Mail / SMTP ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls         # tls | ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=AttendX
MAIL_FROM_EMAIL=noreply@yourcompany.com

# ─── Device Integration ───────────────────────────────────────────────────────
ADMS_PORT=8080              # Granding F09 ADMS push port (primary)
ADMS_PORT_SECONDARY=8081    # Secondary ADMS port
SDK_PORT=4370               # ZKTeco/Granding SDK pull port
DEVICE_PASSWORD=0           # Device communication password (0 = none)
PULL_INTERVAL_SEC=300       # SDK pull interval (5 min)
CONN_TIMEOUT_SEC=15         # Device connection timeout

# ─── Storage ──────────────────────────────────────────────────────────────────
BACKUP_PATH=storage/backups
UPLOAD_PATH=storage/uploads
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FCM_SERVER_KEY=             # Firebase Cloud Messaging server key
